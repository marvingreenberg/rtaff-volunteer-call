#!/usr/bin/env bash
# Idempotent runtime-secret bootstrap. Ensures DATABASE_URL and JWT_SECRET
# exist in GCP Secret Manager and that the Cloud Run runtime SA has
# roles/secretmanager.secretAccessor on each.
#
# - JWT_SECRET: generated via `openssl rand -hex 32` on first run.
# - DATABASE_URL: sourced by invoking scripts/setup-neon-project (which is
#   itself idempotent) and capturing its asyncpg-flavored URL.
#
# Re-running with the same values is a no-op (compares against
# `gcloud secrets versions access latest`).
#
# Prerequisites:
#   - Active GCP project = $GCP_PROJECT_NAME, Secret Manager API enabled
#   - Runtime SA created (run scripts/set-gcloud-creds-for-deploy first)
#   - neonctl authenticated (only needed when DATABASE_URL secret is missing)
#
# Usage:
#   ./scripts/setup-secrets               # ensure both secrets (idempotent)
#   ./scripts/setup-secrets --rotate-jwt  # force a new JWT_SECRET version
#   ./scripts/setup-secrets --refresh-db  # re-run Neon setup and update DB URL
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./_project-config.sh
source "${SCRIPT_DIR}/_project-config.sh"
# shellcheck source=./_lib.sh
source "${SCRIPT_DIR}/_lib.sh"

require_active_gcp_project

RUNTIME_SA_EMAIL="${RUNTIME_SA_NAME}@${PROJECT}.iam.gserviceaccount.com"

usage() {
    cat <<EOF
Usage: $(basename "$0") [--rotate-jwt | --refresh-db]

  (no args)        Ensure both secrets exist; create if missing (idempotent)
  --rotate-jwt     Generate and store a new JWT_SECRET version
  --refresh-db     Re-run setup-neon-project and store its URL as a new version
EOF
    exit 1
}

secret_exists() {
    gcloud secrets describe "$1" --project="$PROJECT" &>/dev/null
}

current_secret_value() {
    gcloud secrets versions access latest --secret="$1" --project="$PROJECT" 2>/dev/null || echo ""
}

# Create the secret (no versions yet) — idempotent.
ensure_secret_container() {
    local name=$1
    if secret_exists "$name"; then
        return 0
    fi
    echo "Creating secret container ${name}..."
    gcloud secrets create "$name" --project="$PROJECT" --replication-policy=automatic &>/dev/null
}

# Add a new version only if the value differs from latest.
add_version_if_changed() {
    local name=$1 value=$2
    local current
    current=$(current_secret_value "$name")
    if [[ "$current" == "$value" ]]; then
        echo "  ${name} — latest version already matches, no new version added"
        return 0
    fi
    echo "  Adding new version to ${name}..."
    printf '%s' "$value" | gcloud secrets versions add "$name" --project="$PROJECT" --data-file=- &>/dev/null
}

ensure_runtime_sa_access() {
    if ! sa_exists "$RUNTIME_SA_EMAIL"; then
        echo "ERROR: Runtime SA ${RUNTIME_SA_EMAIL} does not exist."
        echo "  Run: ./scripts/set-gcloud-creds-for-deploy"
        exit 1
    fi
    grant_secret_role "$RUNTIME_SA_EMAIL" "$DB_SECRET_NAME"  "roles/secretmanager.secretAccessor"
    grant_secret_role "$RUNTIME_SA_EMAIL" "$JWT_SECRET_NAME" "roles/secretmanager.secretAccessor"
}

ensure_jwt_secret() {
    local force=${1:-no}
    ensure_secret_container "$JWT_SECRET_NAME"
    local current
    current=$(current_secret_value "$JWT_SECRET_NAME")
    if [[ -n "$current" && "$force" != "force" ]]; then
        echo "  ${JWT_SECRET_NAME} — value already set, leaving as-is"
        return 0
    fi
    [[ "$force" == "force" ]] && echo "  Rotating ${JWT_SECRET_NAME}..." || echo "  Generating initial ${JWT_SECRET_NAME}..."
    local value
    value=$(openssl rand -hex 32)
    printf '%s' "$value" | gcloud secrets versions add "$JWT_SECRET_NAME" --project="$PROJECT" --data-file=- &>/dev/null
}

ensure_db_secret() {
    local force=${1:-no}
    ensure_secret_container "$DB_SECRET_NAME"
    local current
    current=$(current_secret_value "$DB_SECRET_NAME")
    if [[ -n "$current" && "$force" != "force" ]]; then
        echo "  ${DB_SECRET_NAME} — value already set, leaving as-is"
        return 0
    fi
    echo "  Sourcing DATABASE_URL from scripts/setup-neon-project..."
    local url
    url=$("${SCRIPT_DIR}/setup-neon-project")
    [[ -n "$url" ]] || { echo "ERROR: setup-neon-project returned empty URL"; exit 1; }
    add_version_if_changed "$DB_SECRET_NAME" "$url"
}

MODE="${1:-}"

case "$MODE" in
    --rotate-jwt)
        ensure_jwt_secret force
        ensure_runtime_sa_access
        echo "Done."
        ;;
    --refresh-db)
        ensure_db_secret force
        ensure_runtime_sa_access
        echo "Done."
        ;;
    "")
        ensure_jwt_secret
        ensure_db_secret
        ensure_runtime_sa_access
        echo "Done."
        ;;
    -h|--help|*)
        usage
        ;;
esac
